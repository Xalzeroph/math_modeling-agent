__pycache__/
*.pyc
.venv/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.exe
*.zip
*.tar.gz
releases_new/

# Session 解题产物（只保留目录结构 .gitkeep + 评分报告 + README）
sessions/*
!sessions/.gitkeep
!sessions/README.md
!sessions/*/eval_report.json

# 论文 PDF 不提交（通过 GitHub Releases 下载）
references/papers/*.pdf

# 官方资料中的附件格式不提交
references/官方资料/评阅要点/*.doc
references/官方资料/评阅要点/*.docx
references/官方资料/经验分享/*.doc
references/官方资料/经验分享/*.docx
references/官方资料/经验分享/*.ppt
references/官方资料/经验分享/*.txt
