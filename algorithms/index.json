          ]
        },
        "integer": {
          "name": "整数/混合整数规划",
          "methods": [
            {"id": "milp_branch", "name": "分支定界法", "package": "pulp/mip", "apply": ["整数决策", "选址问题", "调度"], "evolved_status": null},
