          ]
        },
        "metaheuristic": {
          "name": "元启发式算法",
          "methods": [
            {"id": "ga", "name": "遗传算法(GA)", "package": "deap/scipy.optimize.differential_evolution", "apply": ["组合优化", "多峰函数"], "params": {"pop_size": [50, 200], "generations": [100, 500]}, "evolved_status": null},
            {"id": "pso", "name": "粒子群(PSO)", "package": "pyswarms", "apply": ["连续优化", "参数调优"], "params": {"swarm_size": [30, 100], "w": [0.4, 0.9]}, "evolved_status": null},
